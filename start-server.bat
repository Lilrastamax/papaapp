@echo off
start "PapaApp Server" powershell.exe -ExecutionPolicy Bypass -NoExit -Command "$listener = New-Object System.Net.HttpListener; $listener.Prefixes.Add('http://localhost:8080/'); $listener.Start(); Write-Host 'PapaApp: http://localhost:8080' -ForegroundColor Green; $mime = @{'.html'='text/html; charset=utf-8';'.css'='text/css; charset=utf-8';'.js'='application/javascript; charset=utf-8';'.json'='application/json; charset=utf-8';'.png'='image/png'}; $root = 'C:\Users\Max\AppData\Local\Temp\opencode\papaapp-pwa'; while($true){ $ctx = $listener.GetContext(); $p = $ctx.Request.Url.LocalPath; if($p -eq '/'){$p='/index.html'}; $fp = Join-Path $root $p.TrimStart('/'); if(Test-Path $fp -PathType Leaf){ $ext = [IO.Path]::GetExtension($fp); $mt = $mime[$ext]; if(!$mt){$mt='application/octet-stream'}; $bytes = [IO.File]::ReadAllBytes($fp); $ctx.Response.ContentType = $mt; $ctx.Response.ContentLength64 = $bytes.Length; $ctx.Response.OutputStream.Write($bytes,0,$bytes.Length); Write-Host ('200 '+$p) -ForegroundColor Gray } else { $ctx.Response.StatusCode = 404; Write-Host ('404 '+$p) -ForegroundColor Red }; $ctx.Response.Close() }"
